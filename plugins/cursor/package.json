{
  "name": "cursor-plugin-cc",
  "version": "0.3.2",
  "description": "Use Cursor CLI from Claude Code to review code or delegate rescue work.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Cursor Plugin Maintainers",
    "url": "https://github.com/raynaudoe/cursor-plugin-cc"
  },
  "homepage": "https://github.com/raynaudoe/cursor-plugin-cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/raynaudoe/cursor-plugin-cc.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "cursor",
    "cursor-cli",
    "cursor-agent",
    "composer-2.5",
    "ai-coding",
    "agent-delegation"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "plugin.json",
    "scripts",
    "commands",
    "agents"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "companion": "node scripts/cursor-companion.mjs",
    "rescue": "node scripts/rescue.mjs",
    "status": "node scripts/status.mjs",
    "result": "node scripts/result.mjs",
    "cancel": "node scripts/cancel.mjs",
    "setup": "node scripts/setup.mjs",
    "review": "node scripts/review.mjs",
    "adversarial-review": "node scripts/adversarial-review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
